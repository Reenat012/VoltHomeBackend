# Пример настроек для боевого сервера. Скопируйте в .env и заполните. Значения-заготовки сервер ОТВЕРГАЕТ.
# ───────────────
# Server basics
# ───────────────
CORS_ORIGINS=https://volthome.ru,https://api.volthome.ru
# На боевом сервере приложение слушает только сам сервер: HTTPS обслуживает Caddy (docs/DEPLOY.md)
HOST=127.0.0.1
PORT=3000
# Откуда доверять заголовку X-Forwarded-For: loopback (по умолчанию, для Caddy на этом же сервере)
# TRUST_PROXY=loopback

# ───────────────
# OAuth / Yandex ID (docs/SYNC_CONTRACT.md, раздел 4)
# ───────────────
# Нужны для входа по коду (веб). Для входа из Android (токен из SDK) не требуются.
YANDEX_CLIENT_ID=__PUT_LATER__
YANDEX_CLIENT_SECRET=__PUT_LATER__
# Допустимые адреса возврата через запятую; код с другим адресом отклоняется
YANDEX_ALLOWED_REDIRECT_URIS=https://volthome.ru/auth/callback.html

# ───────────────
# PostgreSQL
# ───────────────
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=volthome
PGUSER=volthome
PGPASSWORD=__PUT_LATER__
# У управляемой базы Timeweb нужен SSL: require. Для локальной разработки: disable
PGSSLMODE=require
PG_POOL_MAX=5

# ───────────────
# JWT / sessions (ОБЯЗАТЕЛЬНЫ: без них сервер не запустится)
# ───────────────
# Два РАЗНЫХ случайных секрета не короче 16 символов (лучше 48+), например: openssl rand -base64 48
JWT_ACCESS_SECRET=__PUT_LATER__
JWT_REFRESH_SECRET=__PUT_LATER__
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=90

# ───────────────
# Лимиты
# ───────────────
AUTH_RATE_LIMIT_PER_MIN=30
FREE_PROJECT_LIMIT=3
