# Настройки ТОЛЬКО для локальных тестов. Скопируйте в .env.test (npm run testdb:start сделает это сам).
# Это значения для локальной тестовой базы, не для продакшена.
NODE_ENV=test
PGHOST=127.0.0.1
PGPORT=54329
PGDATABASE=volthome_test
PGUSER=volthome_test
PGPASSWORD=volthome_test_local_only
PGSSLMODE=disable
JWT_ACCESS_SECRET=test-access-secret-not-for-production
JWT_REFRESH_SECRET=test-refresh-secret-not-for-production
DISABLE_HTTPS_REDIRECT=true
